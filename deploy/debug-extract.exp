#!/usr/bin/expect -f
set timeout 120
set password "s\`3}2KG~n@D?N\$P"

spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null /Users/season/AI编程/法律咨询/全链产品/deploy/debug-extract.js ubuntu@1.12.57.22:/home/ubuntu/fazhihui/debug-extract.js
expect {
    -re "password:|Password:" { send "$password\r"; expect eof }
    timeout { puts "TIMEOUT"; exit 1 }
}
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "cd /home/ubuntu/fazhihui && node debug-extract.js"
expect {
    -re "password:|Password:" { send "$password\r"; exp_continue }
    eof
}
