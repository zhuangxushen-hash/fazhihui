#!/usr/bin/expect -f
set timeout 90
set password "s\`3}2KG~n@D?N\$P"

spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "echo '=== /home/ubuntu/fazhihui 根目录 sqlite 文件 ===' && ls -la /home/ubuntu/fazhihui/ | grep -i sqlite; echo '=== 所有相关 sqlite ===' && find /home/ubuntu -name '*.sqlite*' -not -path '*/node_modules/*' 2>/dev/null | xargs ls -la"
expect {
    -re "password:|Password:" {
        send "$password\r"
        exp_continue
    }
    eof
}
