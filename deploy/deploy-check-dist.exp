#!/usr/bin/expect -f
set timeout 90
set password "s\`3}2KG~n@D?N\$P"

spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "echo '=== 服务器 dist 版本 ===' && ls -la /home/ubuntu/fazhihui/backend/dist/system/ 2>/dev/null || echo 'dist/system 目录不存在'; echo '=== 服务器 dist 文件时间 ===' && ls -la /home/ubuntu/fazhihui/backend/dist/main.js; echo '=== 服务器源码是否存在 integration.controller ===' && ls /home/ubuntu/fazhihui/backend/src/system/ 2>/dev/null"
expect {
    -re "password:|Password:" {
        send "$password\r"
        exp_continue
    }
    eof
}
