#!/usr/bin/expect -f
# 部署 talk-sop 修复 + 证据文件修复 + 重建 + 重启
set timeout 400
set password "s\`3}2KG~n@D?N\$P"

# 1. 上传修复文件
puts "=== 1. 上传文件 ==="
spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null /Users/season/AI编程/法律咨询/全链产品/backend/src/lead/talk-sop.controller.ts ubuntu@1.12.57.22:/home/ubuntu/fazhihui/backend/src/lead/talk-sop.controller.ts
expect {
    -re "password:|Password:" { send "$password\r"; expect eof }
    timeout { puts "TIMEOUT"; exit 1 }
}
spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null /Users/season/AI编程/法律咨询/全链产品/deploy/fix-evidence-files.js ubuntu@1.12.57.22:/home/ubuntu/fazhihui/fix-evidence-files.js
expect {
    -re "password:|Password:" { send "$password\r"; expect eof }
    timeout { puts "TIMEOUT"; exit 1 }
}

# 2. 构建 + 修复证据 + 重启
puts "=== 2. 构建并修复 ==="
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "cd /home/ubuntu/fazhihui/backend && npm run build 2>&1 | tail -5 && echo '=== 修复证据文件 ===' && cd /home/ubuntu/fazhihui && NODE_PATH=/home/ubuntu/fazhihui/backend/node_modules node fix-evidence-files.js /home/ubuntu/fazhihui/fazhihui.sqlite && pm2 restart all && pm2 save"
expect {
    -re "password:|Password:" {
        send "$password\r"
        exp_continue
    }
    -re "证据文件修复完成" { exp_continue }
    eof
}
