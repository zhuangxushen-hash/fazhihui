#!/usr/bin/expect -f
# 服务器同步：上传修复后的测试库 + 权限修复脚本，执行并重启
set timeout 300
set password "s\`3}2KG~n@D?N\$P"

# 1. 上传本地修复后的测试库与脚本
puts "=== 1. 上传文件 ==="
spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null /Users/season/AI编程/法律咨询/全链产品/backend/fazhihui.sqlite ubuntu@1.12.57.22:/home/ubuntu/fazhihui/fazhihui.sqlite.new
expect {
    -re "password:|Password:" { send "$password\r"; expect eof }
    timeout { puts "TIMEOUT"; exit 1 }
}
spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null /Users/season/AI编程/法律咨询/全链产品/deploy/fix-perm-loop.js /Users/season/AI编程/法律咨询/全链产品/deploy/check-loop-v2.js ubuntu@1.12.57.22:/home/ubuntu/fazhihui/
expect {
    -re "password:|Password:" { send "$password\r"; expect eof }
    timeout { puts "TIMEOUT"; exit 1 }
}

# 2. 停服务 -> 替换测试库 -> 生产库权限修复 -> 重启 -> 验证
puts "=== 2. 执行同步与修复 ==="
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "cd /home/ubuntu/fazhihui && pm2 stop all && rm -f fazhihui.sqlite-journal && mv fazhihui.sqlite.new fazhihui.sqlite && chown ubuntu:ubuntu fazhihui.sqlite && chmod 644 fazhihui.sqlite && echo '=== 测试库完整性 ===' && NODE_PATH=/home/ubuntu/fazhihui/backend/node_modules node -e \"const db=require('better-sqlite3')('./fazhihui.sqlite');console.log('integrity:',db.pragma('integrity_check',{simple:true}));console.log('menus:',db.prepare('SELECT COUNT(*) c FROM menus').get().c);db.close()\" && echo '=== 生产库权限修复 ===' && NODE_PATH=/home/ubuntu/fazhihui/backend/node_modules node /home/ubuntu/fazhihui/fix-perm-loop.js /home/ubuntu/fazhihui/fazhihui_prod.sqlite && pm2 restart all && pm2 save && echo '=== 测试库闭环验证 ===' && NODE_PATH=/home/ubuntu/fazhihui/backend/node_modules node /home/ubuntu/fazhihui/check-loop-v2.js /home/ubuntu/fazhihui/fazhihui.sqlite 2>&1 | tail -5"
expect {
    -re "password:|Password:" {
        send "$password\r"
        exp_continue
    }
    -re "修复完成|PASS=" { exp_continue }
    eof
}
