#!/usr/bin/expect -f
set timeout 60
set password "s\`3}2KG~n@D?N\$P"

spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "cd /home/ubuntu/fazhihui/backend && ls -la *.sqlite* && whoami && sudo -n true && echo 'sudo ok'"
expect {
    -re "password:|Password:" {
        send "$password\r"
        exp_continue
    }
    eof
}
