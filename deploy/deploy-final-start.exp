set timeout 30
set password "s\`3}2KG~n@D?N\$P"

spawn ssh -o StrictHostKeyChecking=no ubuntu@1.12.57.22 {cd /home/ubuntu/fazhihui && echo "===CREATE_START_SCRIPT===" && cat > start-server.js << 'EOF'
const path = require('path');
const fs = require('fs');

const env = process.env.NODE_ENV || 'development';
const envFile = path.join(__dirname, 'backend', '.env.' + env);
const baseFile = path.join(__dirname, 'backend', '.env');

function loadEnvFile(filePath) {
  if (!fs.existsSync(filePath)) return;
  const content = fs.readFileSync(filePath, 'utf8');
  const lines = content.split('\n');
  for (const line of lines) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith('#')) continue;
    const equalIdx = trimmed.indexOf('=');
    if (equalIdx === -1) continue;
    const key = trimmed.substring(0, equalIdx).trim();
    let value = trimmed.substring(equalIdx + 1).trim();
    if ((value.startsWith('"') && value.endsWith('"')) ||
        (value.startsWith("'") && value.endsWith("'"))) {
      value = value.slice(1, -1);
    }
    if (!(key in process.env)) {
      process.env[key] = value;
    }
  }
}

function loadEnvFileOverride(filePath) {
  if (!fs.existsSync(filePath)) return;
  const content = fs.readFileSync(filePath, 'utf8');
  const lines = content.split('\n');
  for (const line of lines) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith('#')) continue;
    const equalIdx = trimmed.indexOf('=');
    if (equalIdx === -1) continue;
    const key = trimmed.substring(0, equalIdx).trim();
    let value = trimmed.substring(equalIdx + 1).trim();
    if ((value.startsWith('"') && value.endsWith('"')) ||
        (value.startsWith("'") && value.endsWith("'"))) {
      value = value.slice(1, -1);
    }
    process.env[key] = value;
  }
}

loadEnvFile(baseFile);
loadEnvFileOverride(envFile);

console.log('ENV loaded: JWT_SECRET=' + (process.env.JWT_SECRET ? 'SET' : 'MISSING') + ', PORT=' + process.env.PORT);
require('./backend/dist/main.js');
EOF

echo "===TEST_RUN===" && NODE_ENV=production PORT=3001 timeout 10 node start-server.js 2>&1 || echo "TEST_EXIT" && echo "===PM2_RESTART===" && pm2 delete all 2>/dev/null && pm2 start ecosystem.config.js 2>&1 && pm2 save 2>&1 && echo "===PM2_LIST===" && pm2 list --no-color 2>/dev/null}

expect {
    -re "password:|Password:" {
        send "$password\r"
    }
    timeout {
        puts "TIMEOUT waiting for password"
        exit 1
    }
}

expect eof
