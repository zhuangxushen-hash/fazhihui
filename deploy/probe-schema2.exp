#!/usr/bin/expect -f
set timeout 90
set password "s\`3}2KG~n@D?N\$P"
spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null /Users/season/AI编程/法律咨询/全链产品/deploy/probe-schema2.js ubuntu@1.12.57.22:/home/ubuntu/fazhihui/probe-schema2.js
expect {
    -re "password:|Password:" { send "$password\r"; expect eof }
    timeout { puts "TIMEOUT"; exit 1 }
}
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "cd /home/ubuntu/fazhihui && echo '=== 生产库表清单 ===' && node probe-schema2.js fazhihui_prod.sqlite && echo '=== 测试库表清单 ===' && node probe-schema2.js fazhihui.sqlite"
expect {
    -re "password:|Password:" { send "$password\r"; exp_continue }
    eof
}
