set timeout 300
set password "s\`3}2KG~n@D?N\$P"

# 在服务器上添加 GitHub 远程并拉取代码
spawn ssh -o StrictHostKeyChecking=no ubuntu@1.12.57.22 {cd /home/ubuntu/fazhihui && echo "===ADD_GITHUB_REMOTE===" && git remote add github https://github.com/zhuangxushen-hash/fazhihui.git 2>/dev/null || echo "github remote already exists" && echo "===FETCH_GITHUB===" && git fetch github test 2>&1 && echo "===RESET_TO_GITHUB===" && git reset --hard github/test 2>&1 && echo "===LATEST_COMMIT===" && git log --oneline -3}

expect {
    -re "password:|Password:" {
        send "$password\r"
    }
    timeout {
        puts "TIMEOUT waiting for password"
        exit 1
    }
}

expect eof
