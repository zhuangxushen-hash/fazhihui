#!/usr/bin/expect -f
set timeout 90
set password "s\`3}2KG~n@D?N\$P"

spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "echo '=== dist/system 完整列表 ===' && ls /home/ubuntu/fazhihui/backend/dist/system/; echo '=== build 脚本 ===' && grep -A2 '\"scripts\"' /home/ubuntu/fazhihui/backend/package.json | head -20; echo '=== src 修改时间 ===' && ls -la /home/ubuntu/fazhihui/backend/src/system/integration.controller.ts /home/ubuntu/fazhihui/backend/src/finance/finance.controller.ts"
expect {
    -re "password:|Password:" {
        send "$password\r"
        exp_continue
    }
    eof
}
