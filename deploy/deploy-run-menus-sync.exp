#!/usr/bin/expect -f
# 停 PM2 -> 同步测试/生产菜单 -> 重启 PM2
set timeout 240
set password "s\`3}2KG~n@D?N\$P"

spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "cd /home/ubuntu/fazhihui/backend && echo '=== 停止 PM2 ===' && pm2 stop all && echo '=== 同步测试库菜单 ===' && NODE_PATH=/home/ubuntu/fazhihui/backend/node_modules node /home/ubuntu/fazhihui/sync-menus.js /home/ubuntu/fazhihui/backend/fazhihui.sqlite && echo '=== 同步生产库菜单 ===' && NODE_PATH=/home/ubuntu/fazhihui/backend/node_modules node /home/ubuntu/fazhihui/sync-menus.js /home/ubuntu/fazhihui/backend/fazhihui_prod.sqlite && echo '=== 重启 PM2 ===' && pm2 restart all && pm2 save"
expect {
    -re "password:|Password:" {
        send "$password\r"
        exp_continue
    }
    eof
}
