set timeout 30
set password "s\`3}2KG~n@D?N\$P"

spawn ssh -o StrictHostKeyChecking=no ubuntu@1.12.57.22 {echo "===PM2_LIST===" && pm2 list --no-color 2>/dev/null && echo "===PROD_ERROR_LOG===" && cat /home/ubuntu/.pm2/logs/prod-backend-error.log 2>&1 | tail -30 && echo "===PROD_OUT_LOG===" && cat /home/ubuntu/.pm2/logs/prod-backend-out.log 2>&1 | tail -10}

expect {
    -re "password:|Password:" {
        send "$password\r"
    }
    timeout {
        puts "TIMEOUT waiting for password"
        exit 1
    }
}

expect eof
