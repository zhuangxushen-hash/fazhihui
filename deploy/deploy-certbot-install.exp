set timeout 600
set password "s\`3}2KG~n@D?N\$P"

# 安装 certbot
spawn ssh -o StrictHostKeyChecking=no ubuntu@1.12.57.22 {echo "===INSTALL===" && sudo apt-get update 2>&1 | tail -3 && sudo apt-get install -y certbot python3-certbot-nginx 2>&1 | tail -5 && echo "===VERSION===" && certbot --version 2>&1}

expect {
    -re "password:|Password:" {
        send "$password\r"
    }
    timeout {
        puts "TIMEOUT"
        exit 1
    }
}

expect eof
