#!/usr/bin/expect -f
set timeout 90
set password "s\`3}2KG~n@D?N\$P"

spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "echo '=== 测试前端 ===' && curl -s -o /dev/null -w 'HTTP:%{http_code}' https://test.meichuangmenye.com && echo && echo '=== 生产前端 ===' && curl -s -o /dev/null -w 'HTTP:%{http_code}' https://fazhihui.meichuangmenye.com && echo && echo '=== 前端 dist 时间 ===' && ls -la /home/ubuntu/fazhihui/frontend/dist/index.html 2>/dev/null; echo '=== 菜单树接口 ===' && TOKEN=\$(curl -s -X POST http://localhost:3000/api/auth/login -H 'Content-Type: application/json' -d '{\"phone\":\"13800138000\",\"password\":\"123456\"}' | node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{console.log(JSON.parse(s).access_token||'')}catch(e){console.log('')}})\") && curl -s http://localhost:3000/api/menus/tree -H \"Authorization: Bearer \$TOKEN\" | node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{const j=JSON.parse(s);console.log('树顶级节点:',Array.isArray(j)?j.length:'非数组');if(Array.isArray(j)){console.log('分组:',j.map(g=>g.name+'('+(g.children?g.children.length:0)+')').join(', '))}}catch(e){console.log('解析失败:',s.slice(0,200))}})\""
expect {
    -re "password:|Password:" {
        send "$password\r"
        exp_continue
    }
    eof
}
