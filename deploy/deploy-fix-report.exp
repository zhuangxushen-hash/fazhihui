#!/usr/bin/expect -f
set timeout 300
set password "s\`3}2KG~n@D?N\$P"
set server "ubuntu@1.12.57.22"

# 上传改动文件到服务器对应目录
spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null /Users/season/AI编程/法律咨询/全链产品/backend/src/dashboard/dashboard.service.ts "$server:/home/ubuntu/fazhihui/backend/src/dashboard/dashboard.service.ts"
expect {
    -re "password:|Password:" { send "$password\r"; expect eof }
    timeout { puts "TIMEOUT scp1"; exit 1 }
}

spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null /Users/season/AI编程/法律咨询/全链产品/backend/src/dashboard/dashboard.controller.ts "$server:/home/ubuntu/fazhihui/backend/src/dashboard/dashboard.controller.ts"
expect {
    -re "password:|Password:" { send "$password\r"; expect eof }
    timeout { puts "TIMEOUT scp2"; exit 1 }
}

# 重建后端并重启 PM2
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$server" "cd /home/ubuntu/fazhihui/backend && npm run build 2>&1 | tail -n 5 && echo '=== 构建完成，重启PM2 ===' && pm2 restart all 2>&1 | tail -n 3 && sleep 3 && pm2 list 2>&1 | grep -E 'prod-backend|test-backend'"
expect {
    -re "password:|Password:" { send "$password\r"; exp_continue }
    eof
}