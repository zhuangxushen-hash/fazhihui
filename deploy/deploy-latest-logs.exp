set timeout 30
set password "s\`3}2KG~n@D?N\$P"

spawn ssh -o StrictHostKeyChecking=no ubuntu@1.12.57.22 {echo "===PM2_LIST===" && pm2 list --no-color 2>/dev/null && echo "===PROD_ERR===" && tail -10 /home/ubuntu/.pm2/logs/prod-backend-error.log 2>&1 && echo "===TEST_ERR===" && tail -10 /home/ubuntu/.pm2/logs/test-backend-error.log 2>&1 && echo "===PROD_OUT===" && tail -5 /home/ubuntu/.pm2/logs/prod-backend-out.log 2>&1}

expect {
    -re "password:|Password:" {
        send "$password\r"
    }
    timeout {
        puts "TIMEOUT waiting for password"
        exit 1
    }
}

expect eof
