set timeout 30
set password "s\`3}2KG~n@D?N\$P"

spawn ssh -o StrictHostKeyChecking=no ubuntu@1.12.57.22 {cd /home/ubuntu/fazhihui && echo "===STOP_PM2===" && pm2 delete all 2>/dev/null && echo "===CREATE_WRAPPER===" && cat > start-server.js << 'EOF'
const path = require('path');
const dotenv = require('dotenv');
const fs = require('fs');

const env = process.env.NODE_ENV || 'development';
const envFile = path.join(__dirname, 'backend', '.env.' + env);
const baseFile = path.join(__dirname, 'backend', '.env');

if (fs.existsSync(baseFile)) {
  dotenv.config({ path: baseFile });
}
if (fs.existsSync(envFile)) {
  dotenv.config({ path: envFile, override: true });
}

require('./backend/dist/main.js');
EOF

cat > ecosystem.config.js << 'EOF'
module.exports = {
  apps: [
    {
      name: 'prod-backend',
      script: './start-server.js',
      cwd: '/home/ubuntu/fazhihui',
      env: {
        NODE_ENV: 'production',
        PORT: 3001,
      },
    },
    {
      name: 'test-backend',
      script: './start-server.js',
      cwd: '/home/ubuntu/fazhihui',
      env: {
        NODE_ENV: 'development',
        PORT: 3000,
      },
    },
  ],
};
EOF
echo "===START===" && pm2 start ecosystem.config.js 2>&1 && pm2 save 2>&1 && echo "===DONE==="}

expect {
    -re "password:|Password:" {
        send "$password\r"
    }
    timeout {
        puts "TIMEOUT waiting for password"
        exit 1
    }
}

expect eof
