#!/usr/bin/expect -f
set timeout 400
set password "s\`3}2KG~n@D?N\$P"

puts "=== 1. 上传 talk-sop.service.ts ==="
spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null /Users/season/AI编程/法律咨询/全链产品/backend/src/lead/talk-sop.service.ts ubuntu@1.12.57.22:/home/ubuntu/fazhihui/backend/src/lead/talk-sop.service.ts
expect {
    -re "password:|Password:" { send "$password\r"; expect eof }
    timeout { puts "TIMEOUT"; exit 1 }
}

puts "=== 2. 构建并重启 ==="
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "cd /home/ubuntu/fazhihui/backend && npm run build 2>&1 | tail -3 && pm2 restart all && pm2 save"
expect {
    -re "password:|Password:" { send "$password\r"; exp_continue }
    eof
}
