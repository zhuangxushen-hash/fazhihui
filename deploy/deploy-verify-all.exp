#!/usr/bin/expect -f
set timeout 300
set password "s\`3}2KG~n@D?N\$P"

spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null /Users/season/AI编程/法律咨询/全链产品/deploy/verify-all-routes.js /Users/season/AI编程/法律咨询/全链产品/deploy/routes.json ubuntu@1.12.57.22:/home/ubuntu/fazhihui/
expect {
    -re "password:|Password:" { send "$password\r"; expect eof }
    timeout { puts "TIMEOUT"; exit 1 }
}

puts "=== 生产环境全量接口验证 ==="
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "cd /home/ubuntu/fazhihui && node verify-all-routes.js http://localhost:3001 15820275356 zxs123456 ./routes.json"
expect {
    -re "password:|Password:" { send "$password\r"; exp_continue }
    eof
}
