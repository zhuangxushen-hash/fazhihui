#!/usr/bin/expect -f
# 探测测试环境目录结构
set timeout 60
set password "s\`3}2KG~n@D?N\$P"
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "ls /home/ubuntu/fazhihui-test/ && echo '---BACKEND---' && ls /home/ubuntu/fazhihui-test/backend 2>/dev/null | head -20 && echo '---SQLITE---' && find /home/ubuntu/fazhihui-test -name 'fazhihui.sqlite' 2>/dev/null && echo '---BETTER_SQLITE3---' && find /home/ubuntu/fazhihui-test -name 'better-sqlite3' -type d 2>/dev/null | head -3 && echo '---PM2---' && pm2 list 2>/dev/null | grep -E 'test|name'"
expect {
    "password:" {
        send "$password\r"
        expect eof
    }
    eof
}
