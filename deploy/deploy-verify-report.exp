#!/usr/bin/expect -f
set timeout 60
set password "s\`3}2KG~n@D?N\$P"
spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null /Users/season/AI编程/法律咨询/全链产品/deploy/verify-report.js ubuntu@1.12.57.22:/home/ubuntu/fazhihui/verify-report.js
expect {
    -re "password:|Password:" { send "$password\r"; expect eof }
    timeout { puts "TIMEOUT scp"; exit 1 }
}
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ubuntu@1.12.57.22 "cd /home/ubuntu/fazhihui && echo '######## 测试环境(3000) ########' && node verify-report.js http://localhost:3000 && echo && echo '######## 生产环境(3001) ########' && node verify-report.js http://localhost:3001 prod"
expect {
    -re "password:|Password:" { send "$password\r"; exp_continue }
    eof
}