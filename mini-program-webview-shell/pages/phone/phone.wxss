/* pages/phone/phone.wxss */
page {
  background: #f5f7fa;
}

.container {
  min-height: 100vh;
  padding: 140rpx 60rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-name {
  font-size: 48rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 4rpx;
}

.slogan {
  font-size: 26rpx;
  color: #8a8f99;
  margin-top: 14rpx;
}

.card {
  width: 100%;
  margin-top: 110rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 64rpx 48rpx 48rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
}

.desc {
  font-size: 26rpx;
  color: #8a8f99;
  line-height: 1.7;
  margin: 24rpx 0 48rpx;
  text-align: justify;
}

.btn-primary {
  background: #2b5aff;
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary[disabled] {
  background: #a8bdf5;
  color: #ffffff;
}

.skip {
  margin-top: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a8f99;
  padding: 12rpx;
}
