# ============================================================
# 法智汇 生产环境变量示例（法大大「生产环境上线准备」）
# 参考文档：https://dev.fadada.com/api-guide/YYNLQW2Z2W/9QMQ2MU4FGK3AOXA
#
# 本文件为模板，不含任何真实密钥/密码。请将本文件复制为服务器上的
# .env.production 并填入真实值后部署。
#
# ⚠️ 安全红线（用户硬性要求）：
#   - 真实 AppID / AppSecret / openCorpId 属敏感凭证，禁止提交进仓库、
#     禁止写入 memory、禁止打印到日志。
#   - 这些真实值由运维在「服务器本地」的 .env.production 中填写，不外泄。
# ============================================================

# ---------- 法大大（生产环境，本次关键改动）----------
# 模式必须为 prod（非 uat / mock），才会读取下方正式 AppID/Secret 并访问生产域名
FADADA_MODE=prod

# 生产应用标识（从法大大控制台「企业设置-集成管理-应用集成」获取，替换测试 AppID）
FADADA_APP_ID=<生产 AppID>

# 生产应用秘钥（同上，替换测试 AppSecret）
FADADA_APP_SECRET=<生产 AppSecret>

# 生产环境请求域名（文档第五步：由 uat-api.fadada.com 替换为 api.fadada.com/api/v5）
FADADA_API_URL=https://api.fadada.com/api/v5

# 生产回调/重定向域名（必须改为你们的正式域名，且需在法大大后台登记为可信回调地址）
FADADA_REDIRECT_URL=https://<你们的正式域名>/client/sign-after-verify

# 事件回调校验 token（若法大大后台配置了回调验签，此处填对应 token）
FADADA_CALLBACK_TOKEN=<生产回调 token，若未启用回调可留空>

# 发起签约的律所名称（corp 参与方「乙方」用印主体，按实际填写）
FADADA_FIRM_NAME=<律所全称>

# 是否启用法大大能力（true/false）
FADADA_ENABLED=true

# ---------- 其余配置（沿用现生产服务器 .env.production）----------
# 数据库、JWT 密钥、服务端口、CORS、FADADA_INITIATOR_OPEN_ID、FADADA_BUSINESS_ID 等
# 请直接沿用现生产服务器已有 .env.production 中的配置，本模板不涉及，避免误改。
# 部署前请整份 .env.production 与「测试环境 .env」逐键对比，仅替换上面「法大大生产环境」区块。
